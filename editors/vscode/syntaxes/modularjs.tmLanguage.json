          "match": "(@)(viewTransition|vt)(?![a-zA-Z0-9_.:-])",
          "captures": {
            "1": {
              "name": "punctuation.definition.symbol.modularjs"
            },
            "2": {
              "name": "entity.other.attribute-name.modularjs"
            }
          }
        }
      ]
    }
  }
}
