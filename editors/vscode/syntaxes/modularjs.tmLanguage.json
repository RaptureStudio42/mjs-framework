          "name": "invalid.illegal.viewtransition.modularjs"
        },
        {
          "comment": "etiquette calculee `@viewTransition={expr}` — refusee aux 4 positions (l'alias @vt, lui, ne l'est que sur <style> : hors rouge)",
          "match": "(@)(viewTransition)(=)(\\{[^}]*\\})",
          "name": "invalid.illegal.viewtransition.modularjs"
        },
        {
          "comment": "ancienne valeur statique `@viewTransition=\"cube\"` — refusee aux 4 positions, alias @vt compris",
          "match": "(@)(viewTransition|vt)(=)(['\"][^'\"]*['\"])",
          "name": "invalid.illegal.viewtransition.modularjs"
        },
        {
          "comment": "forme canonique avec options : `@viewTransition.cube={ dir: left }` — le corps reste du Civet",
          "begin": "(@)(viewTransition|vt)(\\.[a-zA-Z][a-zA-Z0-9:_-]*)(=)(\\{)",
          "beginCaptures": {
            "1": {
